{
    "name": "ota-eita/composer-guard",
    "description": "Supply-chain checks for composer.json and composer.lock: freshly released versions, plugins allowed to run code, insecure transport and unpinned VCS branches",
    "type": "library",
    "license": "MIT",
    "keywords": ["composer", "security", "supply-chain", "lockfile", "sarif"],
    "authors": [{ "name": "OTA-EITA" }],
    "require": {
        "php": ">=8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "13.4.3",
        "phpstan/phpstan": "2.3.1"
    },
    "autoload": {
        "psr-4": { "ComposerGuard\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "ComposerGuard\\Tests\\": "tests/" }
    },
    "bin": ["bin/composer-guard"],
    "config": {
        "allow-plugins": {},
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress"
    }
}
